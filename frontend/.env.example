# The auth session is a SameSite=Lax cookie, so the browser only keeps it when
# the API shares a site with the page. Ports do not matter, but hostnames do:
# "localhost" and "127.0.0.1" count as different sites. Browse the dashboard on
# the same hostname used here, or logging in will appear to succeed and then
# immediately fail with a 401.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
