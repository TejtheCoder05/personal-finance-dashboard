# PostgreSQL connection used by SQLAlchemy and Alembic.
# Copy this file to .env, replace the placeholder password, and export the
# variable before starting database-backed commands.
DATABASE_URL=postgresql+psycopg://financeiq_user:your_password@localhost:5432/financeiq

# Authentication settings. Generate a local secret with: openssl rand -hex 32
JWT_SECRET_KEY=replace_me_with_a_random_64_character_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Set to true whenever the app is served over HTTPS.
AUTH_COOKIE_SECURE=false

# Comma-separated frontend origins allowed to send the auth cookie. Defaults to
# the local Next.js dev origins. A wildcard is rejected because requests are
# credentialed.
# CORS_ALLOW_ORIGINS=https://financeiq.example.com
